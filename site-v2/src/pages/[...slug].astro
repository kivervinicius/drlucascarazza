---
import Layout from "../layouts/SiteLayout.astro";
import {getCollection,render} from "astro:content";
import {web} from "../lib/catalog";
export async function getStaticPaths(){
 const articles=await getCollection("articles");
 return articles.map(entry=>({params:{slug:entry.data.slug},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<Layout title={entry.data.title} description={entry.data.title+" — informações sobre saúde ocular e oftalmologia. Dr. Lucas Carazza, Tangará da Serra - MT."}>
  <div class="container">
    <article class="article-container">
      <nav class="breadcrumbs" aria-label="Caminho de navegação"><a href="/">Início</a><span>/</span><a href="/conteudos/">Conteúdos</a><span>/</span>{entry.data.title}</nav>
      <header class="article-heading"><p class="eyebrow">Saúde ocular · Conteúdo informativo</p><h1 class="display">{entry.data.title}</h1></header>
      <div class="prose"><Content /></div>
      <p class="article-disclaimer">Estas informações são gerais e não substituem uma consulta com um oftalmologista.</p>
      <div class="article-bottom"><h3>Para conversar sobre seu atendimento</h3><p>A equipe do Dr. Lucas informa sobre consultas e horários disponíveis.</p><a class="button button-primary" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Entrar em contato ↗</a></div>
      <div style="margin-top:30px"><a class="text-link" href="/conteudos/">← Voltar aos conteúdos</a></div>
    </article>
  </div>
</Layout>