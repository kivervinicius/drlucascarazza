---
import Layout from "../layouts/SiteLayout.astro";
import {web} from "../lib/catalog";
const education=[
  {year:"Formação",title:"Medicina — UFMG",detail:"Graduação em Medicina pela Universidade Federal de Minas Gerais."},
  {year:"Residência",title:"Oftalmologia — HC-UFMG",detail:"Residência médica em Oftalmologia pelo Hospital das Clínicas da UFMG."},
  {year:"Complementar",title:"Córnea, catarata e cirurgia refrativa",detail:"Fellowship em córnea, catarata e cirurgia refrativa pelo Hospital das Clínicas da UFMG."},
  {year:"Complementar",title:"Glaucoma e retina",detail:"Formação complementar em glaucoma e retina pelo Hospital das Clínicas da UFMG."},
  {year:"Títulos",title:"Qualificação profissional",detail:"Título de especialista em Oftalmologia pelo MEC e pelo Conselho Brasileiro de Oftalmologia (CBO), conforme currículo divulgado pelo médico."}
];
---
<Layout title="O médico" description="Conheça o Dr. Lucas Carazza, médico oftalmologista CRM-MT 7823 e RQE 3253, formado pela UFMG e atuante em Tangará da Serra.">
  <section class="page-hero"><div class="container">
    <nav class="breadcrumbs" aria-label="Caminho de navegação"><a href="/">Início</a><span>/</span> O médico</nav>
    <p class="eyebrow">Quem é o Dr. Lucas</p><h1 class="display">Dr. Lucas <em>Carazza.</em></h1>
    <p>Graduado em Medicina pela UFMG e com residência em Oftalmologia pelo Hospital das Clínicas da UFMG, o Dr. Lucas atende em Tangará da Serra.</p>
  </div></section>
  <section class="section section-white">
    <div class="container doctor-about-layout">
      <div class="doctor-about-photo"><img src="/media/doctor/portrait.webp" alt="Retrato formal do Dr. Lucas Carazza com jaleco azul e fundo preto" width="1177" height="1337" decoding="async" /></div>
      <div>
        <p class="eyebrow">CRM-MT 7823 · RQE 3253</p>
        <h2 class="display">Formação em <em>Oftalmologia.</em></h2>
        <p>O Dr. Lucas Carazza graduou-se em Medicina pela Universidade Federal de Minas Gerais e realizou residência médica em Oftalmologia no Hospital das Clínicas da UFMG.</p>
        <p>Sua formação complementar abrange córnea, catarata, cirurgia refrativa, glaucoma e retina.</p>
        <div class="doctor-formations"><div><strong>CRM-MT 7823</strong><span>Registro no Conselho Regional de Medicina</span></div><div><strong>RQE 3253</strong><span>Registro de Qualificação de Especialista em Oftalmologia</span></div><div><strong>UFMG</strong><span>Graduação, residência e formação complementar</span></div></div>
        <a class="button button-primary" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Solicitar consulta <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Formação profissional</p><h2 class="display">Trajetória e <em>qualificações.</em></h2><p>Graduação, residência e formação complementar documentadas em sua trajetória profissional.</p></div></div>
      <div class="grid-2">{education.map(item=><div class="card" style="padding:27px"><span class="card-tag">{item.year}</span><h3 style="margin:12px 0">{item.title}</h3><p style="font-size:14px;line-height:1.8;margin:0">{item.detail}</p></div>)}</div>
    </div>
  </section>
  <section class="section section-white">
    <div class="container split">
      <div>
        <p class="eyebrow">Atuação</p>
        <h2 class="display">Córnea, catarata, <em>glaucoma e retina.</em></h2>
        <p>As principais áreas de atuação divulgadas incluem córnea e ceratocone, catarata, cirurgia refrativa, glaucoma e adaptação de lentes de contato.</p>
        <p>As páginas de exames e tratamentos explicam procedimentos oftalmológicos e orientações relacionadas a essas áreas. Confirme a disponibilidade diretamente com a equipe.</p>
        <a class="button button-secondary" href="/tratamentos/">Conhecer os tratamentos <span aria-hidden="true">→</span></a>
      </div>
      <div class="doctor-about-photo doctor-about-photo--portrait"><img src="/media/doctor/portrait-secondary.webp" alt="Dr. Lucas Carazza junto a equipamento de exame oftalmológico" width="1254" height="1254" loading="lazy" /></div>
    </div>
  </section>
  <section class="cta-band"><div class="container"><div><p class="eyebrow" style="color:#9ddae4">Contato com a equipe</p><h2 class="display">Quer agendar sua consulta?</h2><p>Entre em contato para informações sobre atendimento e horários disponíveis.</p></div><a class="button" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Conversar pelo WhatsApp <span aria-hidden="true">↗</span></a></div></section>
</Layout>