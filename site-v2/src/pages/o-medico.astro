---
import Layout from "../layouts/SiteLayout.astro";
import "../styles/physician-editorial.css";
import { web } from "../lib/catalog";

const journey = [
  {step:"01",stage:"GRADUAÇÃO",title:"Medicina",detail:"Universidade Federal de Minas Gerais (UFMG)."},
  {step:"02",stage:"RESIDÊNCIA MÉDICA",title:"Oftalmologia",detail:"Hospital das Clínicas da Universidade Federal de Minas Gerais."},
  {step:"03",stage:"FORMAÇÃO COMPLEMENTAR",title:"Córnea, catarata e cirurgia refrativa",detail:"Aprofundamento profissional nas áreas de córnea e procedimentos oftalmológicos, conforme currículo divulgado pelo médico."},
  {step:"04",stage:"FORMAÇÃO COMPLEMENTAR",title:"Glaucoma e retina",detail:"Formação adicional nas áreas de glaucoma e retina, conforme currículo profissional."}
];
---
<Layout title="O médico" description="Conheça a formação e a trajetória do Dr. Lucas Carazza, oftalmologista em Tangará da Serra, formado pela UFMG. CRM-MT 7823 e RQE 3253.">
  <div class="physician-editorial">
    <section class="pe-hero">
      <div class="container pe-hero-layout">
        <div class="pe-hero-copy">
          <nav class="breadcrumbs" aria-label="Caminho de navegação"><a href="/">Início</a><span>/</span> O médico</nav>
          <p class="pe-label">MÉDICO OFTALMOLOGISTA · TANGARÁ DA SERRA</p>
          <h1>Dr. Lucas <span>Carazza</span></h1>
          <p class="pe-hero-lead">Médico oftalmologista em Tangará da Serra, formado pela UFMG. Conheça sua trajetória profissional e as áreas em que recebeu formação complementar.</p>
          <div class="pe-records"><span>CRM-MT 7823</span><span>RQE 3253</span></div>
        </div>
        <div class="pe-hero-image">
          <img src="/media/doctor/portrait-neutral.webp" alt="Retrato profissional do Dr. Lucas Carazza" width="720" height="1244" loading="eager" decoding="async"/>
        </div>
      </div>
    </section>
    <section class="pe-intro">
      <div class="container pe-intro-layout">
        <p class="pe-section-label">Formação acadêmica</p>
        <div>
          <h2>Medicina e Oftalmologia na UFMG</h2>
          <p>O Dr. Lucas Carazza graduou-se em Medicina pela UFMG e realizou residência médica em Oftalmologia no Hospital das Clínicas da mesma universidade. Sua formação inclui também estudos complementares em córnea, catarata, cirurgia refrativa, glaucoma e retina.</p>
          
        </div>
      </div>
    </section>
    <section class="pe-journey">
      <div class="container pe-journey-layout">
        <div>
          <p class="pe-section-label">Trajetória profissional</p>
          <h2>Graduação, residência e formação complementar</h2>
        </div>
        <div class="pe-journey-list">
          {journey.map(item =>
            <div class="pe-journey-row">
              <span class="pe-journey-index">{item.step}</span>
              <div><small>{item.stage}</small><h3>{item.title}</h3><p>{item.detail}</p></div>
            </div>
          )}
          <div class="pe-professional-records"><strong>Oftalmologia</strong><span>Título de especialista informado no currículo profissional · CRM-MT 7823 · RQE 3253</span></div>
        </div>
      </div>
    </section>
    <section class="pe-areas">
      <div class="container pe-areas-inner">
        <div><p class="pe-section-label">Áreas de atuação</p><h2>Córnea, catarata, cirurgia refrativa e glaucoma</h2></div>
        <div><p>Saiba mais sobre condições e procedimentos oftalmológicos. A indicação de exames ou tratamentos é individualizada, conforme a avaliação de cada paciente.</p><a class="pe-text-link" href="/tratamentos/">Conhecer procedimentos <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <section class="pe-contact">
      <div class="container pe-contact-inner">
        <div><p class="pe-section-label">CONTATO E AGENDAMENTO</p><h2>Quer solicitar uma consulta?</h2><p>A equipe informa horários e condições de atendimento pelo WhatsApp.</p></div>
        <a class="pe-contact-button" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Conversar pelo WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Layout>
