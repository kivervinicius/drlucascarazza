---
import Layout from "../layouts/SiteLayout.astro";
import "../styles/reading-index-editorial.css";
import { getCollection } from "astro:content";

const articles=(await getCollection("articles")).sort((a,b)=>a.data.title.localeCompare(b.data.title,"pt-BR"));
---
<Layout title="Artigos e saúde ocular" description="Artigos informativos sobre catarata, ceratocone, glaucoma, lentes de contato e outras dúvidas de saúde ocular com o Dr. Lucas Carazza.">
  <div class="reading-editorial">
    <section class="ri-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Caminho de navegação"><a href="/">Início</a><span>/</span> Artigos</nav>
        <p class="ri-label">Saúde ocular</p>
        <h1>Artigos e orientações</h1>
        <p>Dúvidas sobre catarata, ceratocone, glaucoma ou o uso de lentes? Consulte os artigos e entenda melhor cada assunto.</p>
      </div>
    </section>
    <section class="ri-body" aria-labelledby="ri-article-list">
      <div class="container">
        <div class="ri-tools">
          <div><p class="ri-label">Publicações</p><h2 id="ri-article-list">Todos os artigos</h2></div>
          <div class="ri-search">
            <label for="ri-search">Buscar por assunto</label>
            <input id="ri-search" type="search" data-filter-input placeholder="Ex.: catarata, glaucoma, lentes..." autocomplete="off" />
            <p data-result-count class="result-count" aria-live="polite">{articles.length} artigos</p>
          </div>
        </div>
        <ol class="ri-list">
          {articles.map((item,index)=>
            <li data-search={item.data.title+" "+item.data.slug}>
              <a href={"/"+item.data.slug+"/"}>
                <span class="ri-number">{String(index+1).padStart(2,"0")}</span>
                <span class="ri-article-title">{item.data.title}</span>
                <span class="ri-read">Ler artigo <span aria-hidden="true">↗</span></span>
              </a>
            </li>
          )}
        </ol>
        <p class="ri-endnote">Os artigos são informativos e não substituem a consulta médica.</p>
      </div>
    </section>
  </div>
</Layout>
