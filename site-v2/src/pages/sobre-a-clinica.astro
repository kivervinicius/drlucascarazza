---
import Layout from "../layouts/SiteLayout.astro";
import {web} from "../lib/catalog";
import {deliveryImage} from "../lib/images";
const map="https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(web.address);
const featuredPhotos=[
  {src:"/media/doctor/hero.webp",alt:"Dr. Lucas Carazza com modelo anatômico do olho no consultório",caption:"No consultório"},
  {src:"/media/doctor/portrait-secondary.webp",alt:"Dr. Lucas Carazza junto a equipamento oftalmológico",caption:"Exames oftalmológicos"},
  {src:"/media/doctor/portrait.webp",alt:"Retrato formal do Dr. Lucas Carazza com fundo preto",caption:"Dr. Lucas Carazza"}
];
const additionalPhotos = [
  ...["Dr3.jpg","Dr12.jpg","Dr13.jpg","Dr18.jpg","Dr19.jpg","Dr20.jpg","Dr28.jpg","D1.jpg","D2.jpg","D3.jpg","D4.jpg"]
    .map((file,i)=>({src:"/media/archive/"+file,alt:"Fotografia do acervo anterior — "+String(i+1).padStart(2,"0")})),
  ...["Oftalmologista-57.jpg","Oftalmologista-58.jpg","Oftalmologista-59.jpg","Oftalmologista-61.jpg","Oftalmologista-50.jpg","Oftalmologista-62.jpg","Oftalmologista-60.jpg",
    "clinica.png","clinica2.png","clinica3.png","clinica4.png","Oftalmologista-44.jpg","Oftalmologista-45.jpg","Oftalmologista-46.jpg",
    "Oftalmologista-47.jpg","Oftalmologista-48.jpg","Oftalmologista-49.jpg","Oftalmologista-56.jpg"]
    .map((file,i)=>({src:"/media/clinic/"+file,alt:"Fotografia do acervo do site anterior — "+String(i+1).padStart(2,"0")}))
];
---
<Layout title="Local de atendimento" description="Saiba onde o Dr. Lucas Carazza atende em Tangará da Serra: Instituto da Visão, Av. Presidente Tancredo de Almeida Neves, 1187-W. Endereço e contatos.">
  <section class="page-hero"><div class="container">
    <nav class="breadcrumbs" aria-label="Caminho de navegação"><a href="/">Início</a><span>/</span> Local de atendimento</nav>
    <p class="eyebrow">Onde o Dr. Lucas atende</p>
    <h1 class="display">Seu atendimento em <em>Tangará da Serra.</em></h1>
    <p>Confira o endereço e as formas de contato para consultas com o Dr. Lucas Carazza.</p>
  </div></section>
  <section class="section section-white">
    <div class="container doctor-local-layout">
      <div>
        <p class="eyebrow">Local de atendimento</p>
        <h2 class="display">No Instituto da <em>Visão.</em></h2>
        <p>O Dr. Lucas Carazza realiza seus atendimentos no Instituto da Visão, localizado na Avenida Presidente Tancredo de Almeida Neves, em Tangará da Serra, em frente ao Fórum Municipal.</p>
        <p>Para informações sobre consultas, horários e localização, fale com a equipe pelo WhatsApp ou telefone.</p>
        <div class="hero-actions"><a class="button button-primary" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Solicitar atendimento <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={map} target="_blank" rel="noopener noreferrer">Traçar rota <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="doctor-local-card">
        <p class="doctor-local-label">Endereço</p>
        <h3>Instituto da Visão</h3><p>{web.address}</p>
        <div class="doctor-formations"><div><strong>Telefone</strong><span><a href={"tel:"+web.phone}>(65) 3326-5201</a></span></div><div><strong>WhatsApp</strong><span><a href={web.whatsapp} target="_blank" rel="noopener noreferrer">(65) 9 9627-6197</a></span></div></div>
        <a class="text-link" href={map} target="_blank" rel="noopener noreferrer">Ver no Google Maps <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container split">
      <div class="doctor-about-photo" style="height:auto;border-radius:22px"><img src="/media/doctor/portrait-secondary.webp" width="1254" height="1254" alt="Dr. Lucas Carazza junto ao aparelho de exame oftalmológico" loading="lazy" /></div>
      <div><p class="eyebrow">Seu médico</p><h2 class="display">Conheça o Dr. Lucas <em>Carazza.</em></h2><p>Graduado em Medicina e com residência médica em Oftalmologia pela UFMG, o Dr. Lucas possui formação complementar em córnea, catarata, cirurgia refrativa, glaucoma e retina.</p><a class="button button-secondary" href="/o-medico/">Conhecer o médico <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="section section-white" id="galeria">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Dr. Lucas Carazza</p>
          <h2 class="display">Conheça o Dr. Lucas <em>em imagens.</em></h2>
          <p>Fotografias atuais do Dr. Lucas, com acesso opcional ao acervo de imagens do site anterior.</p>
        </div>
      </div>
      <div data-photo-gallery>
        <div class="doctor-photo-featured">
          {featuredPhotos.map((photo,i)=><button type="button" class="doctor-photo-card" data-photo-index={i} aria-label={"Ampliar: "+photo.alt}>
            <img src={deliveryImage(photo.src)} alt={photo.alt} width="800" height="1000" loading="lazy" decoding="async" />
            <span class="doctor-photo-caption">{photo.caption} <span aria-hidden="true">↗</span></span>
          </button>)}
        </div>
        <details class="doctor-photo-more">
          <summary>Ver acervo fotográfico anterior <span aria-hidden="true">+</span></summary>
          <div class="doctor-photo-grid">
            {additionalPhotos.map((photo,i)=><button type="button" class="doctor-photo-card doctor-photo-extra" data-photo-index={i+featuredPhotos.length} aria-label={"Ampliar: "+photo.alt}>
              <img src={deliveryImage(photo.src)} alt={photo.alt} width="480" height="360" loading="lazy" decoding="async"/>
              <span class="doctor-photo-caption">Ver fotografia <span aria-hidden="true">↗</span></span>
            </button>)}
          </div>
        </details>
      </div>
    </div>
  </section>
  <dialog id="doctor-photo-viewer" class="doctor-photo-viewer" aria-label="Visualizador de fotografias">
    <div class="doctor-photo-viewer-toolbar">
      <span id="doctor-photo-counter" aria-live="polite"></span>
      <button type="button" data-photo-close aria-label="Fechar imagem">Fechar <span aria-hidden="true">×</span></button>
    </div>
    <div class="doctor-photo-viewer-body">
      <button type="button" data-photo-prev aria-label="Imagem anterior">‹</button>
      <img id="doctor-photo-viewer-image" alt="" width="1254" height="1254"/>
      <button type="button" data-photo-next aria-label="Próxima imagem">›</button>
    </div>
  </dialog>
  <script>
    const gallery=document.querySelector<HTMLElement>("[data-photo-gallery]");
    const viewer=document.querySelector<HTMLDialogElement>("#doctor-photo-viewer");
    const preview=document.querySelector<HTMLImageElement>("#doctor-photo-viewer-image");
    const counter=document.querySelector<HTMLElement>("#doctor-photo-counter");
    if(gallery&&viewer&&preview&&counter){
      const photos=[...gallery.querySelectorAll<HTMLButtonElement>("[data-photo-index]")];
      let selected=0;
      const display=(index:number)=>{
        if(!photos.length)return;
        selected=(index+photos.length)%photos.length;
        const thumb=photos[selected].querySelector("img");
        if(!thumb)return;
        preview.src=thumb.currentSrc || thumb.src;
        preview.alt=thumb.alt;
        counter.textContent=(selected+1)+" de "+photos.length;
        if(!viewer.open)viewer.showModal();
      };
      gallery.addEventListener("click",event=>{
        const button=(event.target as HTMLElement).closest<HTMLButtonElement>("[data-photo-index]");
        if(button)display(Number(button.dataset.photoIndex));
      });
      viewer.querySelector("[data-photo-prev]")?.addEventListener("click",()=>display(selected-1));
      viewer.querySelector("[data-photo-next]")?.addEventListener("click",()=>display(selected+1));
      viewer.querySelector("[data-photo-close]")?.addEventListener("click",()=>viewer.close());
      viewer.addEventListener("click",event=>{if(event.target===viewer)viewer.close();});
      viewer.addEventListener("keydown",event=>{
        if(event.key==="ArrowLeft"){event.preventDefault();display(selected-1);}
        if(event.key==="ArrowRight"){event.preventDefault();display(selected+1);}
      });
    }
  </script>
</Layout>
