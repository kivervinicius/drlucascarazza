---
import Layout from "../layouts/SiteLayout.astro";
import { web } from "../lib/catalog";

const areas = [
  {number:"01",title:"Córnea e ceratocone",detail:"Avaliação e acompanhamento de alterações da córnea, incluindo ceratocone.",href:"/ceratocone/"},
  {number:"02",title:"Cirurgia refrativa",detail:"Informações sobre possibilidades de correção cirúrgica de erros refrativos.",href:"/cirurgia-refrativa/"},
  {number:"03",title:"Catarata",detail:"Avaliação da catarata e orientação sobre alternativas de tratamento e lentes intraoculares.",href:"/catarata-cirurgia/"},
  {number:"04",title:"Glaucoma",detail:"Investigação, acompanhamento e opções de tratamento individualizado.",href:"/glaucoma/"},
  {number:"05",title:"Lentes de contato",detail:"Informações sobre adaptação, utilização e cuidados com lentes de contato.",href:"/lentes/"},
  {number:"06",title:"Saúde ocular",detail:"Consultas, exames diagnósticos e orientação para diferentes fases da vida.",href:"/exames/"}
];
const selected=[
  {title:"Ceratocone: o que é e como acompanhar",href:"/ceratocone/",meta:"Córnea"},
  {title:"Cirurgia refrativa: conheça as possibilidades",href:"/cirurgia-refrativa/",meta:"Cirurgias"},
  {title:"Catarata: dúvidas sobre cirurgia e lentes",href:"/catarata-cirurgia/",meta:"Catarata"}
];


---
<Layout title="Início" description="Dr. Lucas Carazza, médico oftalmologista CRM-MT 7823 e RQE 3253 em Tangará da Serra. Informações sobre córnea, ceratocone, catarata, cirurgia refrativa e saúde ocular.">
  <section class="doctor-hero">
    <div class="container doctor-hero-layout">
      <div class="doctor-hero-copy">
        <p class="eyebrow">Médico oftalmologista · CRM-MT 7823 · RQE 3253</p>
        <h1 class="display">Dr. Lucas <em>Carazza.</em></h1>
        <p class="doctor-hero-lead">Consultas oftalmológicas em Tangará da Serra.</p>
        <p class="doctor-hero-description">Graduado em Medicina e com residência em Oftalmologia pela UFMG, o Dr. Lucas atende em Tangará da Serra. Conheça sua formação e os assuntos abordados no site.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Solicitar consulta pelo WhatsApp <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="#areas-de-atuacao">Conhecer áreas de atuação <span aria-hidden="true">↓</span></a>
        </div>
        <div class="doctor-credentials" aria-label="Identificação profissional"><span>CRM-MT 7823</span><span>RQE 3253</span><span>Formação UFMG</span></div>
      </div>
      <div class="doctor-hero-visual">
        <div class="doctor-hero-backdrop" aria-hidden="true"></div>
        <img class="doctor-portrait-primary" src="/media/doctor/hero-cutout.webp" alt="Dr. Lucas Carazza, médico oftalmologista, em retrato com fundo transparente" width="768" height="903" fetchpriority="high" decoding="async" />
        <div class="doctor-hero-caption"><span class="doctor-hero-caption-kicker">Dr. Lucas Carazza</span><span>Oftalmologista · Tangará da Serra</span></div>
      </div>
    </div>
  </section>
  <section class="doctor-intro-bar" aria-label="Acesso rápido">
    <div class="container doctor-intro-links">
      <a href="#areas-de-atuacao">Áreas de atuação <span aria-hidden="true">↗</span></a>
      <a href="/o-medico/">Formação e trajetória <span aria-hidden="true">↗</span></a>
      <a href="/exames/">Exames disponíveis <span aria-hidden="true">↗</span></a>
      <a href="/conteudos/">Conteúdos e orientações <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="section section-white" id="areas-de-atuacao">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Áreas de atuação</p><h2 class="display">Córnea, catarata, <em>glaucoma e cirurgia refrativa.</em></h2><p>Conheça as áreas destacadas na formação e nos materiais informativos do médico.</p></div><a class="button button-secondary" href="/tratamentos/">Ver todos os tratamentos <span aria-hidden="true">↗</span></a></div>
      <div class="doctor-services">
        {areas.map(area=><a class="doctor-service-card" href={area.href}><span class="doctor-service-index">{area.number}</span><h3>{area.title}</h3><p>{area.detail}</p><span class="doctor-service-link">Conhecer melhor <span aria-hidden="true">↗</span></span></a>)}
      </div>
    </div>
  </section>
  <section class="section doctor-about-section" id="sobre-mim">
    <div class="container doctor-about-layout">
      <div class="doctor-about-photo"><img src="/media/doctor/portrait.webp" alt="Dr. Lucas Carazza junto a equipamento oftalmológico" width="1254" height="1254" loading="lazy" decoding="async" /></div>
      <div>
        <p class="eyebrow">O profissional por trás do atendimento</p>
        <h2 class="display">Formação e trajetória <em>na oftalmologia.</em></h2>
        <p>O Dr. Lucas Carazza é graduado em Medicina e concluiu sua residência em Oftalmologia na Universidade Federal de Minas Gerais (UFMG).</p>
        <p>Realizou formação complementar em córnea, catarata, cirurgia refrativa, glaucoma e retina pelo Hospital das Clínicas da UFMG.</p>
        <div class="doctor-formations"><div><strong>UFMG</strong><span>Graduação e residência médica</span></div><div><strong>CBO · MEC</strong><span>Titulação informada no currículo profissional</span></div><div><strong>CRM 7823 · RQE 3253</strong><span>Registro profissional no Mato Grosso</span></div></div>
        <a class="button button-primary" href="/o-medico/">Conheça o Dr. Lucas <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Saúde ocular em linguagem acessível</p><h2 class="display">Leia sobre <em>catarata, córnea e outros temas.</em></h2><p>Conteúdos sobre ceratocone, cirurgia refrativa e catarata reunidos no site.</p></div><a class="button button-secondary" href="/conteudos/">Explorar artigos <span aria-hidden="true">↗</span></a></div>
      <div class="doctor-articles">{selected.map((article,i)=><a href={article.href} class="doctor-article-card"><span class="card-tag">{article.meta}</span><h3>{article.title}</h3><span class="doctor-article-footer"><span>Leitura informativa</span><span aria-hidden="true">↗</span></span></a>)}</div>
    </div>
  </section>
  <section class="section section-white" id="clinica">
    <div class="container doctor-local-layout">
      <div><p class="eyebrow">Onde o Dr. Lucas atende</p><h2 class="display">Seu atendimento em <em>Tangará da Serra.</em></h2><p>O Dr. Lucas realiza atendimentos no Instituto da Visão, na Avenida Presidente Tancredo de Almeida Neves, 1187-W, em frente ao Fórum Municipal.</p><a class="text-link" href="/sobre-a-clinica/">Endereço e informações de atendimento <span aria-hidden="true">↗</span></a></div>
      <div class="doctor-local-card"><p class="doctor-local-label">Local de atendimento</p><h3>Instituto da Visão</h3><p>{web.address}</p><a class="button button-secondary" href={"https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(web.address)} target="_blank" rel="noopener noreferrer">Traçar rota <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container doctor-faq-layout">
      <div><p class="eyebrow">Informações úteis</p><h2 class="display">Dúvidas antes <em>da consulta?</em></h2><p>Saiba como solicitar uma consulta, confirmar horários e encontrar o local de atendimento.</p></div>
      <div class="doctor-faq-list">
        <details><summary>Como posso agendar uma consulta?</summary><p>Utilize o botão de WhatsApp para conversar com a equipe. Os horários e a confirmação do agendamento são informados diretamente pelo consultório.</p></details>
        <details><summary>Onde o Dr. Lucas realiza seus atendimentos?</summary><p>No Instituto da Visão, Avenida Presidente Tancredo de Almeida Neves, 1187-W, em frente ao Fórum Municipal de Tangará da Serra.</p></details>
        <details><summary>Quais exames e tratamentos são apresentados no site?</summary><p>As páginas de <a href="/exames/">exames</a> e <a href="/tratamentos/">tratamentos</a> reúnem informações educativas. O médico avalia as necessidades de cada paciente antes de indicar qualquer procedimento.</p></details>
        <details><summary>Como confirmar convênios e formas de pagamento?</summary><p>Entre em contato com a equipe para confirmar as condições de atendimento e a cobertura aplicável ao seu caso.</p></details>
      </div>
    </div>
  </section>
  <section class="cta-band">
    <div class="container"><div><p class="eyebrow" style="color:#9ddae4">Agendamento</p><h2 class="display">Entre em contato para solicitar sua consulta.</h2><p>Consulte os horários disponíveis pelo WhatsApp. A equipe confirma o agendamento.</p></div><a class="button" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Conversar pelo WhatsApp <span aria-hidden="true">↗</span></a></div>
  </section>
</Layout>