---
import Layout from "../layouts/SiteLayout.astro";
import "../styles/home-editorial.css";
import { web } from "../lib/catalog";

// Os links apontam para conteúdos já existentes. A Home não cria novas ofertas médicas.
const quickLinks = [
  { title: "Exames oftalmológicos", description: "Consultas e exames da visão", url: "/exames/" },
  { title: "Tratamentos e cirurgias", description: "Indicações e procedimentos", url: "/tratamentos/" },
  { title: "Artigos de saúde ocular", description: "Dúvidas e orientações", url: "/conteudos/" }
];

const topics = [
  { title: "Catarata", description: "Visão embaçada ou perda gradual de nitidez? Entenda como a catarata é avaliada e quando a cirurgia pode ser considerada.", href: "/catarata-cirurgia/" },
  { title: "Ceratocone", description: "Distorções na visão e mudanças frequentes no grau podem estar relacionadas a alterações na córnea.", href: "/ceratocone/" },
  { title: "Cirurgia refrativa", description: "Saiba o que é considerado na avaliação de quem deseja reduzir a dependência dos óculos ou das lentes.", href: "/cirurgia-refrativa/" },
  { title: "Glaucoma", description: "Uma condição que pode evoluir sem sintomas. Conheça a importância dos exames e do acompanhamento.", href: "/glaucoma/" }
];

const articles = [
  { title: "Ceratocone", detail: "Córnea e alterações da visão", href: "/ceratocone/" },
  { title: "Catarata e Cirurgia de Catarata", detail: "Avaliação e tratamento", href: "/catarata-cirurgia/" },
  { title: "Cirurgia Refrativa", detail: "Miopia, hipermetropia e astigmatismo", href: "/cirurgia-refrativa/" }
];
---
<Layout
  home={true}
  title="Início"
  description="Dr. Lucas Carazza, médico oftalmologista em Tangará da Serra. CRM-MT 7823, RQE 3253. Informações sobre consultas, catarata, ceratocone, glaucoma e cirurgia refrativa."
>
  <div class="editorial-home">
    <section class="dc-hero" aria-labelledby="dc-home-title">
      <div class="container dc-hero-grid">
        <div class="dc-hero-copy">
          <p class="dc-label">Oftalmologista · Tangará da Serra, MT</p>
          <h1 id="dc-home-title">Dr. Lucas<br />Carazza<span class="dc-period">.</span></h1>
          <p class="dc-hero-focus">Oftalmologia, córnea, catarata e saúde ocular.</p>
          <p class="dc-hero-description">Está com alguma alteração na visão, recebeu um diagnóstico ou precisa de acompanhamento? Conheça a formação do Dr. Lucas e encontre informações sobre exames e tratamentos oftalmológicos.</p>
          <div class="dc-actions">
            <a class="dc-primary" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Agendar consulta <span aria-hidden="true">↗</span></a>
            <a class="dc-secondary" href="/o-medico/">Conhecer o Dr. Lucas <span aria-hidden="true">→</span></a>
          </div>
          <p class="dc-credentials">CRM-MT 7823 <span aria-hidden="true">·</span> RQE 3253</p>
        </div>
        <div class="dc-hero-image">
          <img
            src="/media/doctor/hero-blue-transparent.webp"
            alt="Dr. Lucas Carazza com jaleco e gravata azuis"
            width="1177"
            height="1337"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <nav class="dc-quick" aria-label="Acessos rápidos">
      <div class="container dc-quick-grid">
        {quickLinks.map((link) =>
          <a class="dc-quick-link" href={link.url}>
            <span><strong>{link.title}</strong><small>{link.description}</small></span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </nav>

    <section class="dc-topics" id="areas-de-atuacao" aria-labelledby="dc-topics-title">
      <div class="container">
        <div class="dc-section-heading">
          <div>
            <p class="dc-label">Áreas de atuação</p>
            <h2 id="dc-topics-title">Informações para cuidar da sua visão</h2>
          </div>
          <p>Conheça algumas condições e procedimentos oftalmológicos. A indicação de exames e tratamentos depende da avaliação de cada paciente.</p>
        </div>
        <div class="dc-topic-grid">
          {topics.map((topic) =>
            <a class="dc-topic" href={topic.href}>
              <div class="dc-topic-top"><h3>{topic.title}</h3><span aria-hidden="true">↗</span></div>
              <p>{topic.description}</p>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="dc-profile" aria-labelledby="dc-profile-title">
      <div class="container dc-profile-grid">
        <div class="dc-profile-intro">
          <p class="dc-label">O médico</p>
          <h2 id="dc-profile-title">Formação e experiência profissional</h2>
          <p>Graduado em Medicina pela Universidade Federal de Minas Gerais (UFMG), o Dr. Lucas também realizou residência médica em Oftalmologia no Hospital das Clínicas da UFMG. Sua formação complementar inclui córnea, catarata, cirurgia refrativa, glaucoma e retina.</p>
          <a class="dc-textlink" href="/o-medico/">Conheça sua trajetória <span aria-hidden="true">→</span></a>
        </div>
        <div class="dc-profile-facts">
          <div><strong>UFMG</strong><span>Graduação em Medicina e residência em Oftalmologia</span></div>
          <div><strong>CRM-MT 7823</strong><span>Registro profissional</span></div>
          <div><strong>RQE 3253</strong><span>Qualificação em Oftalmologia</span></div>
        </div>
      </div>
    </section>

    <section class="dc-articles" aria-labelledby="dc-articles-title">
      <div class="container">
        <div class="dc-section-heading dc-articles-heading">
          <div>
            <p class="dc-label">Artigos</p>
            <h2 id="dc-articles-title">Tire suas dúvidas sobre saúde ocular</h2>
          </div>
          <a class="dc-textlink" href="/conteudos/">Todos os artigos <span aria-hidden="true">→</span></a>
        </div>
        <div class="dc-article-list">
          {articles.map((article) =>
            <a class="dc-article" href={article.href}>
              <div><h3>{article.title}</h3><span>{article.detail}</span></div>
              <span class="dc-article-arrow" aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="dc-contact" aria-labelledby="dc-contact-title">
      <div class="container dc-contact-grid">
        <div>
          <p class="dc-label">Atendimento</p>
          <h2 id="dc-contact-title">Consultas em Tangará da Serra</h2>
          <p>Instituto da Visão · Parque das Mansões</p>
          <p>Para informações sobre horários e agendamentos, entre em contato com a equipe.</p>
        </div>
        <a class="dc-contact-action" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Falar pelo WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Layout>
