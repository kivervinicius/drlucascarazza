---
import Layout from "../layouts/SiteLayout.astro";
import "../styles/home-editorial.css";
import { web } from "../lib/catalog";

const routes = [
  { number: "01", title: "Exames", detail: "Entenda o que cada avaliação investiga", href: "/exames/" },
  { number: "02", title: "Tratamentos", detail: "Conheça possibilidades e indicações", href: "/tratamentos/" },
  { number: "03", title: "Saúde ocular", detail: "Tire suas dúvidas com informação clara", href: "/conteudos/" }
];

const areas = [
  { number: "01", label: "Córnea", title: "Ceratocone", detail: "Se as imagens parecem distorcidas ou seu grau muda com frequência, vale entender o que acontece com a córnea.", href: "/ceratocone/" },
  { number: "02", label: "Cristalino", title: "Catarata", detail: "Quando a visão perde nitidez, a avaliação ajuda a esclarecer se a catarata está por trás da mudança e quais são as opções.", href: "/catarata-cirurgia/" },
  { number: "03", label: "Correção do grau", title: "Cirurgia refrativa", detail: "Para quem considera reduzir a dependência dos óculos, a consulta é o primeiro passo para avaliar indicação e limites.", href: "/cirurgia-refrativa/" },
  { number: "04", label: "Nervo óptico", title: "Glaucoma", detail: "O glaucoma pode evoluir sem sintomas. Saiba por que os exames e o acompanhamento são importantes.", href: "/glaucoma/" }
];

const reading = [
  { number: "01", label: "Entenda a córnea", title: "Ceratocone: quais sinais merecem atenção?", href: "/ceratocone/" },
  { number: "02", label: "Dúvidas sobre cirurgia", title: "Cirurgia refrativa: quem pode ser avaliado?", href: "/cirurgia-refrativa/" },
  { number: "03", label: "Visão e envelhecimento", title: "Catarata: como funciona a cirurgia?", href: "/catarata-cirurgia/" }
];
---
<Layout
  home={true}
  title="Início"
  description="Dr. Lucas Carazza, médico oftalmologista em Tangará da Serra (CRM-MT 7823, RQE 3253). Informações sobre córnea, catarata, glaucoma, cirurgia refrativa e agendamento."
>
  <div class="editorial-home">
    <section class="ed-hero" aria-labelledby="editorial-home-title">
      <div class="container ed-hero-inner">
        <div class="ed-hero-copy">
          <p class="ed-kicker"><span class="ed-kicker-line" aria-hidden="true"></span>MÉDICO OFTALMOLOGISTA EM TANGARÁ DA SERRA</p>
          <h1 id="editorial-home-title" class="ed-hero-name">Dr. Lucas <span>Carazza<span class="ed-period">.</span></span></h1>
          <p class="ed-hero-statement">A visão merece atenção aos detalhes.</p>
          <p class="ed-hero-description">Da mudança no grau às dúvidas sobre catarata ou ceratocone, compreender o diagnóstico ajuda a decidir o próximo passo. Conheça o trabalho do Dr. Lucas e saiba como solicitar uma consulta.</p>
          <div class="ed-hero-actions">
            <a href={web.whatsapp} class="ed-button ed-button-dark" target="_blank" rel="noopener noreferrer">Solicitar consulta <span aria-hidden="true">↗</span></a>
            <a href="/o-medico/" class="ed-underlink">Conhecer o médico <span aria-hidden="true">↗</span></a>
          </div>
          <div class="ed-hero-credentials"><span>CRM-MT 7823</span><span>RQE 3253</span></div>
        </div>
        <div class="ed-hero-portrait">
          <span class="ed-portrait-monogram" aria-hidden="true">LC</span>
          <img
            src="/media/doctor/hero-blue-transparent.webp"
            alt="Dr. Lucas Carazza com jaleco e gravata azuis"
            width="1177"
            height="1337"
            fetchpriority="high"
            decoding="async"
          />
          <div class="ed-photo-signature" aria-hidden="true"><span>DR. LUCAS CARAZZA</span><span>OFTALMOLOGIA</span></div>
        </div>
      </div>
      <div class="ed-hero-bottom" aria-hidden="true"><div class="container"><span>CUIDADO COM A VISÃO</span><span>TANGARÁ DA SERRA · MT</span></div></div>
    </section>

    <nav class="ed-route-band" aria-label="Por onde começar">
      <div class="container ed-route-inner">
        <span class="ed-route-heading">POR ONDE COMEÇAR</span>
        <div class="ed-route-items">
          {routes.map(route =>
            <a class="ed-route" href={route.href}>
              <span class="ed-route-number">{route.number}</span>
              <span class="ed-route-copy"><strong>{route.title}</strong><small>{route.detail}</small></span>
              <span class="ed-route-arrow" aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </nav>

    <section class="ed-areas" id="areas-de-atuacao" aria-labelledby="ed-areas-title">
      <div class="container ed-areas-layout">
        <div class="ed-areas-intro">
          <p class="ed-section-label">01 / ÁREAS DE ATUAÇÃO</p>
          <h2 id="ed-areas-title" class="ed-title">Cada visão tem <span>uma história.</span></h2>
          <p>Mudanças na visão podem ter causas diferentes. Conheça algumas condições oftalmológicas e os cuidados que podem ser considerados após uma avaliação.</p>
          <a href="/tratamentos/" class="ed-underlink">Exames e tratamentos <span aria-hidden="true">↗</span></a>
        </div>
        <div class="ed-area-list">
          {areas.map(area =>
            <a href={area.href} class="ed-area-row">
              <span class="ed-area-index">{area.number}</span>
              <div class="ed-area-text">
                <span class="ed-area-label">{area.label}</span>
                <h3>{area.title}</h3>
                <p>{area.detail}</p>
              </div>
              <span class="ed-area-arrow" aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="ed-bio" aria-labelledby="ed-bio-title">
      <div class="container ed-bio-layout">
        <div class="ed-bio-side">
          <p class="ed-section-label">02 / QUEM VAI ATENDER VOCÊ</p>
          <span class="ed-bio-initial" aria-hidden="true">L.</span>
        </div>
        <div class="ed-bio-copy">
          <h2 id="ed-bio-title" class="ed-title">Formação sólida. <span>Um médico para conhecer de perto.</span></h2>
          <p>O Dr. Lucas Carazza graduou-se em Medicina na Universidade Federal de Minas Gerais (UFMG) e realizou residência em Oftalmologia no Hospital das Clínicas da UFMG. Sua formação complementar inclui córnea, catarata, cirurgia refrativa, glaucoma e retina.</p>
          <div class="ed-bio-foot">
            <div class="ed-bio-credentials"><strong>UFMG</strong><span>Medicina e residência em Oftalmologia</span></div>
            <a href="/o-medico/" class="ed-underlink">Conhecer a trajetória <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="ed-reading" aria-labelledby="ed-reading-title">
      <div class="container">
        <div class="ed-reading-head">
          <div>
            <p class="ed-section-label">03 / LEITURAS</p>
            <h2 id="ed-reading-title" class="ed-title">Conhecer ajuda <span>a cuidar.</span></h2>
          </div>
          <div class="ed-reading-aside">
            <p>Uma dúvida sobre os olhos pode trazer muitas perguntas. Comece por estas leituras sobre condições e procedimentos oftalmológicos.</p>
            <a href="/conteudos/" class="ed-underlink">Todos os artigos <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="ed-article-list">
          {reading.map(article =>
            <a class="ed-article-row" href={article.href}>
              <span class="ed-article-index">{article.number}</span>
              <span class="ed-article-content"><small>{article.label}</small><strong>{article.title}</strong></span>
              <span class="ed-article-arrow" aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="ed-contact" aria-labelledby="ed-contact-title">
      <div class="container ed-contact-inner">
        <div>
          <p class="ed-section-label">ATENDIMENTO EM TANGARÁ DA SERRA</p>
          <h2 id="ed-contact-title" class="ed-title">Vamos conversar <span>sobre sua visão?</span></h2>
          <p>Consultas no Instituto da Visão, no Parque das Mansões. Entre em contato com a equipe para consultar horários disponíveis.</p>
        </div>
        <a href={web.whatsapp} target="_blank" rel="noopener noreferrer" class="ed-button ed-button-light">Falar pelo WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Layout>
