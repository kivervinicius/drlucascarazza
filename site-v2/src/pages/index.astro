---
import Layout from "../layouts/SiteLayout.astro";
import "../styles/home-compact.css";
import { web } from "../lib/catalog";

const shortcuts = [
  { number: "01", title: "Exames oftalmológicos", description: "Conheça os exames abordados no site.", url: "/exames/" },
  { number: "02", title: "Doenças oculares", description: "Informações sobre condições da visão.", url: "/doencas-oculares/" },
  { number: "03", title: "Tratamentos", description: "Leia sobre procedimentos e indicações.", url: "/tratamentos/" }
];
---
<Layout
  title="Início"
  description="Conheça o Dr. Lucas Carazza, médico oftalmologista em Tangará da Serra (CRM-MT 7823, RQE 3253). Informações sobre formação, exames e saúde ocular."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container home-hero-grid">
      <div class="home-hero-content">
        <p class="eyebrow">Dr. Lucas Carazza · Médico oftalmologista</p>
        <h1 id="home-title" class="display">A sua visão merece <em>um olhar atento.</em></h1>
        <p class="home-hero-lead">Atendimento oftalmológico em Tangará da Serra. Conheça a formação do Dr. Lucas, as informações sobre exames e os conteúdos de saúde ocular reunidos no site.</p>
        <div class="home-hero-actions">
          <a class="button button-primary" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Solicitar consulta <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/o-medico/">Conheça o médico <span aria-hidden="true">→</span></a>
        </div>
        <p class="home-hero-caption">CRM-MT 7823 · RQE 3253 · Tangará da Serra, MT</p>
      </div>
      <div class="home-visual">
        <img
          src="/media/doctor/hero-cutout.webp"
          alt="Retrato original do Dr. Lucas Carazza, com fundo transparente"
          width="768"
          height="903"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <nav class="container home-shortcuts" aria-label="Explorar conteúdos do site">
    {shortcuts.map(item =>
      <a href={item.url} class="home-shortcut">
        <span class="home-shortcut-number" aria-hidden="true">{item.number}</span>
        <span class="home-shortcut-content"><strong>{item.title}</strong><small>{item.description}</small></span>
        <span class="home-shortcut-arrow" aria-hidden="true">↗</span>
      </a>
    )}
  </nav>

  <section class="home-about" aria-labelledby="home-about-title">
    <div class="container home-about-grid">
      <div>
        <p class="eyebrow">Formação e trajetória</p>
        <h2 id="home-about-title" class="display">Conheça o <em>Dr. Lucas Carazza.</em></h2>
      </div>
      <div class="home-about-text">
        <p>Graduado em Medicina pela Universidade Federal de Minas Gerais (UFMG), com residência em Oftalmologia no Hospital das Clínicas da UFMG e formação complementar em córnea, catarata, cirurgia refrativa, glaucoma e retina.</p>
        <a class="text-link" href="/o-medico/">Saiba mais sobre sua formação <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-contact" aria-labelledby="home-contact-title">
    <div class="container home-contact-inner">
      <div>
        <h2 id="home-contact-title">Informações e agendamento</h2>
        <p>Atendimento no Instituto da Visão, em Tangará da Serra. Confirme os horários com a equipe.</p>
      </div>
      <a class="button" href={web.whatsapp} target="_blank" rel="noopener noreferrer">Falar pelo WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
