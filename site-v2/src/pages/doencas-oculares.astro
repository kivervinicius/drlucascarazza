---
import Layout from "../layouts/SiteLayout.astro";
import {conditions} from "../lib/catalog";
const total=conditions.reduce((n,g)=>n+g.items.length,0);
---
<Layout title="Doenças oculares" description="Artigos educativos sobre catarata, glaucoma, ceratocone, miopia, olho seco e outras doenças oculares.">
<section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Caminho de navegação"><a href="/">Início</a><span>/</span> Doenças oculares</nav><p class="eyebrow">Biblioteca de saúde ocular</p><h1 class="display">Conheça as <em style="color:var(--teal)">doenças oculares.</em></h1><p>Acesse artigos sobre catarata, glaucoma, ceratocone, miopia e outras condições que afetam os olhos.</p></div></section>
<section class="section"><div class="container"><div class="searchbar"><input type="search" data-filter-input aria-label="Buscar doenças" placeholder="Buscar por doença ou sintoma..." /></div><p class="result-count" data-result-count>{total} resultados</p>
{conditions.map(group=><section class="group-section" data-group><h2 class="display">{group.title} <span>{group.items.length} conteúdos</span></h2><div class="grid-3">{group.items.map(item=><a class="card" style="padding:26px" href={item.nikName?.href||"/conteudos/"} data-search={item.name+" "+group.title}><span class="card-tag">Saúde ocular</span><h3 style="margin:14px 0">{item.name}</h3><span class="text-link">Saiba mais <span aria-hidden="true">→</span></span></a>)}</div></section>)}
</div></section>
</Layout>